# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# claude code, per-machine settings
.claude/settings.local.json

# pyulog reference for verify:ulog. Generated from ../logs, which are not in this
# repository, and it carries the flights' GPS coordinates and the board's UUID.
# Regenerate: python scripts/pyulog_reference.py ../logs scripts/ulog-reference.json
/scripts/ulog-reference.json

# the observer: its Python environment is made on each computer, never copied
/mcp/observer/.venv/
__pycache__/

# the desktop app: built, never written by hand
/desktop/dist/
/release/
/out-hosted/
